<Window
    x:Class="CatAssistant.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="小猫助手">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#FFF7EADB" Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="🐱" FontSize="54"/>
                <TextBlock Text="小猫助手" FontSize="28" FontWeight="SemiBold" Foreground="#FF5D4037"/>
                <TextBlock Text="Windows AI 网关" Foreground="#FF795548"/>
                <NavigationView x:Name="Navigation" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" SelectionChanged="Navigation_SelectionChanged" Background="Transparent">
                    <NavigationView.MenuItems>
                        <NavigationViewItem Content="连接" Tag="connection" Icon="Bluetooth" IsSelected="True"/>
                        <NavigationViewItem Content="状态" Tag="status" Icon="Message"/>
                    </NavigationView.MenuItems>
                </NavigationView>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Padding="32">
            <StackPanel x:Name="ConnectionPanel" Spacing="14">
                <TextBlock Text="连接卡片" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="扫描、选择并建立加密 BLE 连接。" Foreground="Gray"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="扫描" Click="Scan_Click"/>
                    <Button Content="连接所选设备" Click="Connect_Click"/>
                    <Button Content="忘记设备并重新配对" Click="Forget_Click"/>
                </StackPanel>
                <ListView x:Name="DeviceList" ItemsSource="{x:Bind Coordinator.Devices}" Height="260" SelectionMode="Single"/>
                <InfoBar IsOpen="True" Severity="Informational" Title="连接诊断" Message="{x:Bind Coordinator.Detail, Mode=OneWay}"/>
                <TextBlock Text="{x:Bind Coordinator.MaxPduText, Mode=OneWay}" FontFamily="Consolas"/>
            </StackPanel>

            <StackPanel x:Name="StatusPanel" Spacing="14" Visibility="Collapsed">
                <TextBlock Text="运行状态" FontSize="26" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="新对话" Click="NewConversation_Click"/>
                    <Button Content="取消当前轮次" Click="CancelTurn_Click"/>
                </StackPanel>
                <Border CornerRadius="12" Background="#FFF7EADB" Padding="24">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Coordinator.Status, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="#FF5D4037"/>
                        <TextBlock Text="{x:Bind Coordinator.Detail, Mode=OneWay}" TextWrapping="Wrap" MaxHeight="340"/>
                        <TextBlock Text="{x:Bind Coordinator.MaxPduText, Mode=OneWay}" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="关闭窗口后应用继续在托盘运行。不会记录 API Key、原始录音或调试对话日志。" TextWrapping="Wrap" Foreground="Gray"/>
            </StackPanel>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                <StackPanel Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock Text="DashScope API Key（使用当前 Windows 用户的 DPAPI 加密保存）" TextWrapping="Wrap"/>
                    <PasswordBox x:Name="ApiKeyBox" PlaceholderText="留空表示不更改；输入后保存"/>
                    <TextBlock Text="ASR 模型"/><TextBox x:Name="AsrModelBox" Text="{x:Bind Coordinator.Settings.AsrModel, Mode=TwoWay}"/>
                    <TextBlock Text="聊天模型"/><TextBox x:Name="ChatModelBox" Text="{x:Bind Coordinator.Settings.ChatModel, Mode=TwoWay}"/>
                    <TextBlock Text="屏幕超时（秒，0 表示永不）"/><NumberBox x:Name="ScreenTimeoutBox" Minimum="0" Maximum="86400"/>
                    <CheckBox x:Name="AutoReconnectBox" Content="记住设备并自动重连" IsChecked="{x:Bind Coordinator.Settings.AutoReconnect, Mode=TwoWay}"/>
                    <Button Content="保存设置" Click="SaveSettings_Click" HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
