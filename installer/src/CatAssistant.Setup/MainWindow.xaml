<Window x:Class="CatAssistant.Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小猫助手安装程序" Width="960" Height="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI,Microsoft YaHei UI" Closing="Window_Closing">
  <Border x:Name="RootShell" Background="#FBFCFD" CornerRadius="20" BorderBrush="#DDE4E9" BorderThickness="1"
          SizeChanged="RootShell_SizeChanged">
    <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.20" Color="#233347" /></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="76" /></Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="#FCFDFE" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <StackPanel Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
          <Border Width="28" Height="28" Background="#EAF1F7" CornerRadius="8">
            <Image Source="Assets/brand.png" Width="22" Height="22" Stretch="Uniform" />
          </Border>
          <TextBlock Text="小猫助手安装程序" Margin="10,0,0,0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="—" Width="46" Height="54" Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#657080" Click="Minimize_Click" />
          <Button Content="×" Width="46" Height="54" Background="Transparent" BorderThickness="0" FontSize="20" Foreground="#657080" Click="Close_Click" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Background="#FFFFFF">
        <Grid x:Name="PageHost">
          <Grid x:Name="WelcomePage" Margin="92,50,92,44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*" /><ColumnDefinition Width="0.92*" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="16" Height="2" Background="#466987" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="准备就绪" Margin="8,0,0,0" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="让小猫助手，&#x0a;住进你的电脑。" FontSize="42" FontWeight="SemiBold" LineHeight="51" />
              <TextBlock Text="桌面 AI 对话、Work 工作空间与 AI Passport 连接能力，将在几分钟内准备完成。"
                         Margin="0,16,0,0" Width="420" HorizontalAlignment="Left" Foreground="#657080" FontSize="14" TextWrapping="Wrap" LineHeight="24" />
            </StackPanel>
            <Grid Grid.Column="1" Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse Width="286" Height="286" Fill="#EFF6F9" Stroke="#DCE9F0" StrokeThickness="1" />
              <Ellipse Width="224" Height="224" Fill="#DCEBF3" />
              <Border Width="150" Height="150" Background="#FFFFFF" CornerRadius="40">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.16" Color="#233347" /></Border.Effect>
                <Image Source="Assets/brand.png" Width="112" Height="112" Stretch="Uniform" />
              </Border>
            </Grid>
          </Grid>

          <Grid x:Name="VersionPage" Visibility="Collapsed" Margin="120,54">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Width="154" Height="154" Background="#EFF6F9" CornerRadius="42" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.16" Color="#233347" /></Border.Effect>
              <Image Source="Assets/brand.png" Width="116" Height="116" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="48,0,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="16" Height="2" Background="#466987" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="即将安装" Margin="8,0,0,0" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="小猫助手" FontSize="42" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <TextBlock Text="应用版本" Foreground="#657080" FontSize="13" VerticalAlignment="Center" />
                <Border Background="#EAF1F7" CornerRadius="8" Margin="10,0,0,0" Padding="10,5">
                  <TextBlock x:Name="AppVersionText" Text="1.0.0" Foreground="#466987" FontSize="13" FontWeight="SemiBold" />
                </Border>
              </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="CheckPage" Visibility="Collapsed" Margin="92,46,92,34">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="16" Height="2" Background="#466987" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="安装检查" Margin="8,0,0,0" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="先确认一切顺利。" FontSize="36" FontWeight="SemiBold" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" Margin="0,28,0,12" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="CheckResultsPanel" />
            </ScrollViewer>
            <Grid Grid.Row="2">
              <Border x:Name="CheckSummary" Visibility="Collapsed" Background="#E8F4EE" CornerRadius="12" Padding="14,11" HorizontalAlignment="Left">
                <TextBlock Text="所有检查均已通过" Foreground="#46715F" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <Button Content="重新检查" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Padding="16,8" Click="RetryChecks_Click" />
            </Grid>
          </Grid>

          <Grid x:Name="OptionsPage" Visibility="Collapsed" Margin="92,42,92,34">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Width="16" Height="2" Background="#466987" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="安装选项" Margin="8,0,0,0" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="按你的习惯准备。" FontSize="36" FontWeight="SemiBold" />
              <TextBlock Text="安装位置" FontWeight="SemiBold" FontSize="12" Margin="0,30,0,9" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border BorderBrush="#D8E0E5" BorderThickness="1" CornerRadius="10" Height="44" Padding="13,0" Background="#FFFFFF">
                  <TextBox x:Name="InstallPath" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="12" TextChanged="InstallPath_TextChanged" />
                </Border>
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Padding="18,10" Click="Browse_Click" />
              </Grid>
              <Border x:Name="LocationStatusBorder" Background="#F2F5F7" CornerRadius="9" Margin="0,7,0,16" Padding="11,8" HorizontalAlignment="Left">
                <TextBlock x:Name="LocationStatusText" Text="正在检查安装位置…" Foreground="#657080" FontSize="10" TextWrapping="Wrap" MaxWidth="650" />
              </Border>
              <Border Background="#FFFFFF" BorderBrush="#E4E9ED" BorderThickness="1" CornerRadius="14" Padding="18,12">
                <StackPanel>
                  <CheckBox x:Name="DesktopShortcut" Content="创建桌面快捷方式" IsChecked="True" />
                  <CheckBox x:Name="StartMenuShortcut" Content="添加到开始菜单" IsChecked="True" />
                  <CheckBox x:Name="LaunchAfterInstall" Content="安装完成后启动小猫助手" IsChecked="True" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <Grid x:Name="InstallingPage" Visibility="Collapsed" Margin="92,54,92,48">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Width="650" HorizontalAlignment="Center">
              <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Border Width="134" Height="134" Background="#EFF6F9" CornerRadius="38" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity="0.16" Color="#233347" /></Border.Effect>
                <Image Source="Assets/brand.png" Width="102" Height="102" Stretch="Uniform" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="42,0,0,0">
                <TextBlock Text="正在安装" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
                <TextBlock Text="正在安装小猫助手" Margin="0,10,0,8" FontSize="34" FontWeight="SemiBold" />
                <TextBlock x:Name="InstallStatus" Text="正在准备安装资源…" Foreground="#657080" FontSize="12" />
                <TextBlock x:Name="ProgressPercentText" Text="0%" Margin="0,12,0,0" Foreground="#466987" FontSize="12" FontWeight="SemiBold" />
              </StackPanel>
            </Grid>
            <Border x:Name="ProgressTrack" Grid.Row="1" Background="#E6ECEF" CornerRadius="5" Height="10" ClipToBounds="True" SizeChanged="ProgressTrack_SizeChanged">
              <Grid ClipToBounds="True">
                <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="5" Background="#466987" />
                <Border x:Name="ProgressShimmer" Width="150" HorizontalAlignment="Left">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="#00FFFFFF" Offset="0" />
                      <GradientStop Color="#70FFFFFF" Offset="0.5" />
                      <GradientStop Color="#00FFFFFF" Offset="1" />
                    </LinearGradientBrush>
                  </Border.Background>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="CompletePage" Visibility="Collapsed" Margin="150,60">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
                <Border Width="16" Height="2" Background="#466987" CornerRadius="2" VerticalAlignment="Center" />
                <TextBlock Text="安装完成" Margin="8,0,0,0" Foreground="#466987" FontSize="11" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock x:Name="CompleteTitle" Text="欢迎回来，小猫助手。" FontSize="39" FontWeight="SemiBold" TextAlignment="Center" />
              <TextBlock x:Name="CompleteMessage" Margin="0,14,0,0" Foreground="#657080" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" />
              <Border x:Name="LogPanel" Visibility="Collapsed" Background="#F4F6F8" CornerRadius="12" Padding="16" Margin="0,24,0,0" Width="530">
                <StackPanel>
                  <TextBlock Text="诊断日志" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock x:Name="LogPathText" Margin="0,6,0,0" Foreground="#657080" FontSize="10" TextWrapping="Wrap" />
                  <Button Content="打开日志位置" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7" Click="OpenLogs_Click" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>

      <Border Grid.Row="2" BorderBrush="#E7EBEF" BorderThickness="0,1,0,0" Background="#FCFDFE">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,24,0">
          <Button x:Name="BackButton" Content="上一步" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Back_Click" Visibility="Collapsed" />
          <Button x:Name="NextButton" Content="继续" Style="{StaticResource PrimaryButton}" Click="Next_Click" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
